# THE CASA BASICS — Backend Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# ─── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/casabasics?retryWrites=true&w=majority
# Local example: mongodb://localhost:27017/casabasics
MONGO_URI=mongodb://localhost:27017/casabasics

# ─── JWT ─────────────────────────────────────────
# Use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── Stripe (Sandbox / Test Keys ONLY) ────────────
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ─── Admin Seed Account ──────────────────────────
# Used only by scripts/seed.js to create the first admin
ADMIN_EMAIL=admin@thecasabasics.com
ADMIN_PASSWORD=AdminPass123!

# ─── CORS ────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

